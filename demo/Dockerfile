FROM python:3.12-alpine
WORKDIR /app
COPY app.py .
# Test faults, baked into the image. CI fills them from release.env.
ARG APP_VERSION=v1
ARG COLOR=#2563eb
ARG ERROR_RATE=0
ARG LATENCY_MS=0
ARG LATENCY_JITTER_MS=0
ARG FAIL_READINESS=false
ARG LEAK_MB_PER_MIN=0
ARG WRONG_ANSWER=false
ENV APP_VERSION=$APP_VERSION COLOR=$COLOR ERROR_RATE=$ERROR_RATE LATENCY_MS=$LATENCY_MS \
    LATENCY_JITTER_MS=$LATENCY_JITTER_MS FAIL_READINESS=$FAIL_READINESS LEAK_MB_PER_MIN=$LEAK_MB_PER_MIN \
    WRONG_ANSWER=$WRONG_ANSWER
EXPOSE 8080
CMD ["python", "app.py"]
