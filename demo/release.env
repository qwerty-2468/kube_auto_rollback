# One code release = one image. Edit, commit, push: CI builds the image and
# points rollback-platform's demo app at it. Faults are not set here: they are
# env vars in rollback-platform's gitops/apps/<app>/base/release.yaml.
# APP_VERSION becomes part of the image tag: letters, digits, . _ - only.
APP_VERSION=healthy
COLOR="#15db18"
