# One release = one image. Edit, commit, push: CI builds the image with these
# values baked in and points rollback-platform's demo app at it.
# APP_VERSION becomes part of the image tag: letters, digits, . _ - only.
APP_VERSION=reset
COLOR="#15db18"
ERROR_RATE=0          # % of /api/work requests that return 500
LATENCY_MS=0          # fixed delay added to every /api/work request
LATENCY_JITTER_MS=0   # extra random delay, 0..N ms
FAIL_READINESS=false  # true: /health returns 503, pods never become Ready
LEAK_MB_PER_MIN=0     # memory held and never freed (limit is 128Mi)
WRONG_ANSWER=false    # true: /api/work returns 200 with a wrong result (5051 instead of 5050)
